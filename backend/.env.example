# Backend configuration template. Copy to .env (Docker Compose) and .env.local (running on the host).
# .env is loaded first; .env.local overrides it. Neither is committed.

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Only needed when the frontend is not served through the Vite/nginx proxy.
CORS_ORIGINS=["http://localhost:5173"]

# --- Database ---
DATABASE_URL=postgresql+asyncpg://calorie:calorie@postgres:5432/calorie_tracker
TEST_DATABASE_URL=postgresql+asyncpg://calorie:calorie@postgres:5432/calorie_tracker_test

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
