# Frontend configuration template. Copy to .env and .env.local.
# Variables prefixed with VITE_ are embedded in the browser bundle: never put secrets here.

# Base path for API calls. Same-origin: the Vite dev proxy or nginx forwards it to the backend.
VITE_API_BASE_URL=/api/v1

# Used only by vite.config.ts (not exposed to the browser): where the dev proxy forwards /api.
DEV_PROXY_TARGET=http://localhost:8000
